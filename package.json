{
  "name": "nextjs-coding-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "bun node_modules/.bin/eslint src",
    "type-check": "tsc --noEmit",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "test:coverage": "bun test src/ --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage"
  },
  "dependencies": {
    "@vercel/speed-insights": "^1.3.1",
    "next": "^16.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "bun-types": "latest",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.1.5",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
